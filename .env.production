# ==============================================================================
# 💎 WOX WHATSAPP ENTERPRISE PRODUCTION CONFIGURATION (aaPanel / Direct VPS)
# ==============================================================================

# 1. Server Configuration
NODE_ENV=production
SERVER_NAME=wox-production
SERVER_TYPE=http
SERVER_PORT=8080
# ضع رابط الدومين الحقيقي الخاص بك هنا:
SERVER_URL=https://yourdomain.com

# 2. Global Security & Authentication Keys
AUTHENTICATION_API_KEY=YOUR_VERY_STRONG_GLOBAL_API_KEY_HERE_2026
JWT_SECRET=your_ultra_secure_jwt_secret_key_oxtech_production_2026
JWT_REFRESH_SECRET=your_ultra_secure_jwt_refresh_secret_key_oxtech_production_2026

# 3. Database Configuration (PostgreSQL / MySQL on aaPanel)
# اختر PostgreSQL أو MySQL:
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://wox_user:StrongPassword123@127.0.0.1:5432/wox_db?schema=public'
DATABASE_CONNECTION_CLIENT_NAME=wox_production

# إذا كنت تستخدم MySQL قم بتفعيل السطرين التاليين وإلغاء تفعيل PostgreSQL:
# DATABASE_PROVIDER=mysql
# DATABASE_CONNECTION_URI='mysql://wox_user:StrongPassword123@127.0.0.1:3306/wox_db'

# 4. Redis Cache Configuration (مهم جداً للأداء العالي والـ Rate Limiter)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI='redis://127.0.0.1:6379'
CACHE_REDIS_PREFIX_KEY=wox_prod
CACHE_REDIS_TTL=604800

# 5. WhatsApp & Instance Storage Configuration
DEL_INSTANCE=false
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_DELETE_MESSAGE=false

# 6. CORS & Security
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# 7. Logging Levels (Production optimized)
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
LOG_BAILEYS=error

# 8. Webhooks & Event Listeners
EVENT_EMITTER_MAX_LISTENERS=100
