# ==============================================================================
# Wox WhatsApp - Production Environment Configuration Template
# Set these variables on your aaPanel Linux server
# ==============================================================================

NODE_ENV=production
SERVER_NAME=wox
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://wox.oxtech.uk

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=https://wox.oxtech.uk,http://wox.oxtech.uk
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Database Provider (MySQL on aaPanel)
DATABASE_PROVIDER=mysql
DATABASE_CONNECTION_URI='mysql://wox_user:YOUR_STRONG_PASSWORD@localhost:3306/wox_whatsapp'
DATABASE_CONNECTION_CLIENT_NAME=wox_production

# Redis Cache (Install Redis in aaPanel App Store)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://localhost:6379/6
CACHE_REDIS_PREFIX_KEY=wox

# Master API Security Key (Replace with a 32+ character random string)
AUTHENTICATION_API_KEY=replace_with_a_super_secret_high_entropy_api_key_here

# JWT Security Secrets for SaaS Users & Tenants
JWT_ACCESS_SECRET=replace_with_jwt_access_secret_for_wox_production_saas
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret_for_wox_production_saas

# Logging
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
LOG_BAILEYS=error

# Webhook Retry & Security
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_MAX=5
